# ═══════════════════════════════════════════════════════
# Amvera: уменьшаем Docker-контекст — ускоряет COPY . .
# ═══════════════════════════════════════════════════════

# Архив (ненужные в рантайме файлы)
archive/

# Документация и планы
docs/
plans/

# Тесты
tests/
.pytest_cache/

# Git (оставляем .git для отображения версии на /admin)
.gitignore
.kilocode/

# IDE
.idea/
.vscode/

# Окружение
.env
.env.example
.env.amvera

# Docker / деплой
Dockerfile
docker-compose.yml

# README, чеклисты, логи — кроме requirements.txt (нужен pip install)
*.md
*.txt
!requirements.txt

# Tailwind (собирается на Render, не нужен в Amvera)
tailwind.config.js

# PWA / TWA (собирается отдельно)
twa-config.json

# Бинарники, временные файлы
*.pyc
__pycache__/
*.log
*.bat
*.sh
