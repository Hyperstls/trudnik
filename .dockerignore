# ═══════════════════════════════════════════════════════
# Amvera: уменьшаем Docker-контекст — ускоряет COPY . .
# ═══════════════════════════════════════════════════════

# Архив (ненужные в рантайме файлы)
archive/

# Документация и планы
docs/
plans/

# Тесты
tests/
.pytest_cache/

# Git
.git
.github
.gitignore
.kilocode/

# IDE
.idea/
.vscode/

# Uploads (не копировать пользовательские файлы)
uploads/avatars

# Окружение
.env
.env.example
.env.amvera
.venv/

# Frontend/toolchain — не нужны в Django-образе (и в Flask-образе тоже)
node_modules/

# Мусор/бэкапы/эксперименты
trash/
Trudnik backup/
twa-project/
tests_e2e/
*.png

# Docker / деплой
Dockerfile
docker-compose.yml

# README, чеклисты, логи — кроме requirements.txt (нужен pip install)
*.md
*.txt
!requirements.txt

# Tailwind (собирается на Render, не нужен в Amvera)
tailwind.config.js

# PWA / TWA (собирается отдельно)
twa-config.json

# Бинарники, временные файлы
*.pyc
__pycache__/
*.log
*.bat
*.sh

# Env-файлы (даже placeholder-шаблоны не должны попадать в образ)
scripts/env_*.env
archive/env_*.env
.env.staging
