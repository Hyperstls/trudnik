2. В `_increment_login_attempts` — exponential backoff + сброс:
```python
def _increment_login_attempts(lockout_key, attempts_key, email):
    try:
        client = get_redis_client()
        if client is None:
            return
        attempts = client.incr(attempts_key)
        if attempts == 1:
            client.expire(attempts_key, 900)
        if attempts >= 5:
            # Exponential backoff
            lockout_count_key = f"login_lockout_count:{email}"
            lockout_count = int(client.get(lockout_count_key) or 0)
            lockout_duration = 900 * (2 ** lockout_count)  # 900, 1800, 3600, 7200
            client.setex(lockout_key, lockout_duration, str(lockout_count + 1))
            client.delete(attempts_key)  # сброс счётчика
            log.warning('Account locked: %s for %d sec (attempt %d)', email, lockout_duration, lockout_count + 1)
    except Exception as e:
        log.warning('Failed: %s', e)

def _clear_login_attempts(lockout_key, attempts_key, email=None):
    try:
        client = get_redis_client()
        if client is None:
            return
        client.delete(attempts_key, lockout_key)
        if email:
            client.delete(f"login_lockout_count:{email}")
    except Exception:
        pass
```

