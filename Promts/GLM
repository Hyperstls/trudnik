    };

    this.ws.onmessage = (event) => {
        try {
            const data = JSON.parse(event.data);
            if (data.type === 'connected') {
                this.isConnecting = false;
                this._emit('connected', {});
            } else {
                this._handleMessage(data);
            }
        } catch (e) {
            console.warn('WS parse error:', e);
