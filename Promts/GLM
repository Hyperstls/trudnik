### ЗАДАЧА 2-7: Устранить DB connection leak

**Приоритет:** HIGH
**Depends on:** none
**Файлы:** `app/blueprints/auth.py:_login_direct_sql()`

**Решение:**
```python
def _login_direct_sql(email: str, password: str) -> dict | None:
    db_url = _get_db_url()
    if not db_url:
        raise RuntimeError("DATABASE_URL не задан")
    import psycopg2
    conn = None
    try:
        conn = psycopg2.connect(db_url, connect_timeout=10)
        conn.autocommit = True
        with conn.cursor() as cur:
            cur.execute("""
                SELECT id, email, role, full_name, password_hash
                FROM profiles
                WHERE LOWER(email) = LOWER(%s) AND password_hash = crypt(%s, password_hash)
            """, (email, password))
            row = cur.fetchone()

            if row:
                # Пере-хешировать если rounds < 12 (задача 1-12)
                stored_hash = row[4]
                if stored_hash and (stored_hash.startswith('$2a$06$') or stored_hash.startswith('$2b$06$')):
                    import bcrypt
                    new_hash = bcrypt.hashpw(password.encode('utf-8'), bcrypt.gensalt(rounds=12)).decode('utf-8')
                    cur.execute("UPDATE profiles SET password_hash = %s WHERE id = %s", (new_hash, row[0]))

                return {'user_id': str(row[0]), 'email': row[1], 'role': row[2], 'full_name': row[3]}
            return None
    except ImportError:
        raise RuntimeError("psycopg2 не установлен")
    except Exception as e:
        log.error("login: direct SQL failed: %s", e)
        raise RuntimeError(f"Не удалось подключиться к БД: {e}")
    finally:
        if conn is not None:
            try:
                conn.close()
            except Exception:
                pass
```

**Acceptance criteria:**
- [ ] При exception — `conn.close()` вызывается в `finally`

