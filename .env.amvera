# ═══════════════════════════════════════════════════════════
# Amvera — переменные окружения для всех сервисов trudnik
# Загрузить: Amvera → Приложение → Переменные → Подгрузить .env
# ═══════════════════════════════════════════════════════════

# ── Flask ──────────────────────────────────────────────
SECRET_KEY=***REMOVED***
DEPLOYMENT_ENV=production
WORKER_SITE_URL=https://trudnik-hyperstls.amvera.io/

# ── PostgREST ──────────────────────────────────────────
POSTGREST_URL=http://amvera-hyperstls-run-trudnik-pr:3000
PGRST_JWT_SECRET=***REMOVED***

# ── Redis ──────────────────────────────────────────────
REDIS_URL=redis://:***REMOVED***@amvera-hyperstls-run-trudnik-redis:6379/0

# ── База данных (приложение, пользователь trudnikapp) ──
DATABASE_URL=postgresql://trudnikapp:***REMOVED***@amvera-hyperstls-cnpg-trudnik-db-rw:5432/trudnik
PGUSER=trudnikapp
PGPASSWORD=***REMOVED***
PGHOST=amvera-hyperstls-cnpg-trudnik-db-rw
PGPORT=5432
PGDATABASE=trudnik

# ── База данных (админ, для миграций/pgAdmin) ─────────
DATABASE_ADMIN_URL=postgresql://postgres:hyperstls@amvera-hyperstls-cnpg-trudnik-db-rw:5432/trudnik

# ── Email (SMTP Яндекс.Почта) ─────────────────────────
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=587
SMTP_USER=trudnik-app@yandex.ru
SMTP_PASSWORD=lvszpkuthmspixnv
SMTP_FROM_EMAIL=trudnik-app@yandex.ru
SMTP_FROM_NAME=Trudnik
SMTP_USE_TLS=True

# ── Yandex Maps ───────────────────────────────────────
YANDEX_MAPS_API_KEY=***REMOVED***

# ── Web Push (VAPID) ──────────────────────────────────
VAPID_PRIVATE_KEY=JcuSS7MGN4UA_kug7f0dCII4tsCmDEEL6DfbIV79ixs
VAPID_PUBLIC_KEY=BClxC95yUwEjQxeQ34vUy7aKcgaRlroW9usaNRdvRojyyARN_xExMVLjVTu7xXKUfU9Sa-GmTxMbE4lNuknDuRs
VAPID_CLAIMS_EMAIL=trudnik-app@yandex.ru
VAPID_CLAIMS_SUBJECT=mailto:trudnik-app@yandex.ru

# ── WebSocket ─────────────────────────────────────────
WEBSOCKET_PORT=8001
WEBSOCKET_URL=wss://trudnik-hyperstls.amvera.io/ws

# ── Circuit Breaker ───────────────────────────────────
CB_RECOVERY_TIMEOUT=30
CB_FAILURE_THRESHOLD=10

# ── GIT_TOKEN (используется для пуша на Amvera через CI) ──
GIT_TOKEN=***REMOVED***

# ── pgAdmin (сервис, если будет добавлен) ─────────────
PGADMIN_DEFAULT_EMAIL=admin@trudnik.ru
PGADMIN_DEFAULT_PASSWORD=***REMOVED***
PGADMIN_CONFIG_SERVER_MODE=True
PGADMIN_LISTEN_PORT=80
PGADMIN_CONFIG_ENHANCED_COOKIE_PROTECTION=False
