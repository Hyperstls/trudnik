# ═══════════════════════════════════════════════════════
# Переменные окружения для Amvera
# 
# ИНСТРУКЦИЯ:
# 1. Откройте Render Dashboard → trudnik → Environment
# 2. Скопируйте значения и замените "скопировать_из_Render" ниже
# 3. Для DATABASE_URL: Supabase Dashboard → Database → Connection string (порт 6543)
# 4. Для SMTP: вставьте свои данные почтового сервера
# 5. VAPID ключи уже сгенерированы, не меняйте
# 6. Загрузите этот файл в Amvera кнопкой "Подгрузить .env"
# ═══════════════════════════════════════════════════════

# --- Из Render (обязательные) ---
SECRET_KEY=***REMOVED***
SUPABASE_URL=https://***REMOVED***.supabase.co
SUPABASE_ANON_KEY=***REMOVED***
SUPABASE_SERVICE_ROLE_KEY:***REMOVED***
YANDEX_MAPS_API_KEY=***REMOVED***


# --- Из Supabase Dashboard ---
DATABASE_URL=postgresql://postgres.xxxxx:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# --- SMTP (заполните свои данные) ---
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=587
SMTP_USER=notifications@trudnik.ru
SMTP_PASSWORD=ваш_пароль_приложения
SMTP_FROM_EMAIL=notifications@trudnik.ru
SMTP_FROM_NAME=Trudnik

# --- Web Push (VAPID) - уже сгенерированы ---
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_CLAIMS_EMAIL=notifications@trudnik.ru

# --- WebSocket (не менять) ---
WEBSOCKET_PORT=8001

# --- Режим работы ---
FLASK_ENV=production
WORKER_SITE_URL=https://trudnik-hyperstls.amvera.io/

# --- Версия (опционально, иначе вычисляется из git log / 'dev') ---
GIT_VERSION=81e27d8 2026-06-19 (PWA icons + push API)
