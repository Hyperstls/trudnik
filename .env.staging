# =============================================================================
# Переменные окружения для STAGING-сервера trudnik-staging
# Скопируйте в Amvera Console → Проект trudnik-staging → Переменные окружения
# =============================================================================

# ── Режим работы ────────────────────────────────────────────────────────────
DEPLOYMENT_ENV=staging
DEBUG=false

# ── Flask ────────────────────────────────────────────────────────────────────
SECRET_KEY=замените-на-такой-же-как-в-production
FLASK_ENV=production

# ── Админский токен (НОВЫЙ, отличается от production) ────────────────────────
ADMIN_API_TOKEN=***REMOVED***

# ── PostgREST ───────────────────────────────────────────────────────────────
POSTGREST_URL=замените-на-POSTGREST_URL-staging-базы
PGRST_JWT_SECRET=замените-на-такой-же-как-в-production

# ── База данных (Amvera создаст автоматически при создании проекта) ──────────
DATABASE_URL=замените-на-DATABASE_URL-который-выдаст-Amvera
DB_HOST=замените-на-хост-staging-базы
DB_PORT=5432
DB_NAME=trudnik
DB_USER=postgres
DB_PASSWORD=замените-на-пароль-staging-базы

# ── Redis (Amvera создаст автоматически) ────────────────────────────────────
REDIS_URL=замените-на-REDIS_URL-который-выдаст-Amvera

# ── Почта (SMTP) ────────────────────────────────────────────────────────────
SMTP_HOST=smtp.mail.ru
SMTP_PORT=587
SMTP_USER=замените
SMTP_PASSWORD=замените
SMTP_USE_TLS=True
SMTP_USE_SSL=False
SMTP_FROM_EMAIL=notifications@trudnik.ru
SMTP_FROM_NAME=Trudnik

# ── Карты ────────────────────────────────────────────────────────────────────
YANDEX_MAPS_API_KEY=замените-на-такой-же-как-в-production

# ── Монетизация ─────────────────────────────────────────────────────────────
MONETIZATION_ENABLED=true

# ── Версия ───────────────────────────────────────────────────────────────────
GIT_VERSION=staging
WORKER_SITE_URL=

# ── Тестовые пользователи (пароли сгенерированы) ────────────────────────────
TEST_USER_PASSWORD=changeme123

# ── Пароль администратора при инициализации БД ──────────────────────────────
# Установить через: ALTER DATABASE trudnik SET app.admin_init_password = '...'
# app.admin_init_password=замените-на-надёжный-пароль
