# ============================================================
# Amvera Managed PostgreSQL: trudnik-db
# Внутренний хост: amvera-hyperstls-cnpg-trudnik-db-rw
# ============================================================
# ВНИМАНИЕ: trudnik-db — это управляемый (managed) PostgreSQL.
# Переменные окружения для этого сервиса НЕ настраиваются.
# Все параметры задаются при создании сервиса.
# Этот файл — справочный, хранит учётные данные.
# ============================================================

# Пользователь приложения (обычные права)
APP_USER=trudnikapp
APP_PASSWORD=PLACEHOLDER_DB_PASSWORD
APP_DB=trudnik

# Суперпользователь (полные права)
SUPERUSER=postgres
SUPERUSER_PASSWORD=PLACEHOLDER_DB_PASSWORD

# Строки подключения (для справки):
# App:    postgresql://trudnikapp:CHANGE_ME_REPLACE_WITH_SECURE_VALUE@amvera-hyperstls-cnpg-trudnik-db-rw:5432/trudnik
# Admin:  postgresql://postgres:CHANGE_ME_REPLACE_WITH_SECURE_VALUE@amvera-hyperstls-cnpg-trudnik-db-rw:5432/trudnik
