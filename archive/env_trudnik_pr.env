# ============================================================
# Amvera env-файл для сервиса: trudnik-pr (PostgREST)
# Внутренний хост: amvera-hyperstls-run-trudnik-pr
# ============================================================

# Подключение к БД
PGRST_DB_URI=postgresql://trudnikapp:PLACEHOLDER_DB_PASSWORD@amvera-hyperstls-cnpg-trudnik-db-rw:5432/trudnik
PGRST_DB_SCHEMA=public
PGRST_DB_ANON_ROLE=anon
PGRST_DB_POOL=10
PGRST_DB_EXTRA_SEARCH_PATH=public

# JWT
PGRST_JWT_SECRET=PLACEHOLDER_JWT_SECRET
PGRST_JWT_AUD=authenticated
PGRST_JWT_ROLE_CLAIM_KEY=.role

# Сервер
PGRST_SERVER_HOST=0.0.0.0
PGRST_SERVER_PROXY_URI=https://trudnik-hyperstls.amvera.io
PGRST_OPENAPI_SERVER_PROXY_URI=https://trudnik-hyperstls.amvera.io
