# ============================================================
# Amvera env-файл для сервиса: trudnik-pgadmin (pgAdmin)
# Внутренний хост: amvera-hyperstls-run-trudnik-pgadmin
# ============================================================
# ВНИМАНИЕ: Подключение к БД настраивается вручную через веб-интерфейс pgAdmin:
#   Серверы → Register → Server → Connection
# ============================================================

PGADMIN_DEFAULT_EMAIL=admin@trudnik.ru
PGADMIN_DEFAULT_PASSWORD=PLACEHOLDER_PGADMIN_PASSWORD
PGADMIN_CONFIG_SERVER_MODE=True
PGADMIN_LISTEN_PORT=80

# Параметры для ручной настройки сервера в pgAdmin:
#   Name: trudnik-db-superuser
#   Host name/address: amvera-hyperstls-cnpg-trudnik-db-rw
#   Port: 5432
#   Maintenance database: trudnik
#   Username: postgres
#   Password: CHANGE_ME_REPLACE_WITH_SECURE_VALUE
#   SSL mode: prefer
