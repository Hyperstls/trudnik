# Django «Трудник» (единственный прод с 2026-10-30).
# python:3.12-slim, /data (pip-cache/pycache), appuser, /health.
FROM python:3.12-slim

WORKDIR /app

ARG GIT_VERSION=dev
ENV GIT_VERSION=$GIT_VERSION

# Amvera: изменяемые runtime-файлы — под /data; статика вшивается в образ (быстрый старт).
ENV PIP_CACHE_DIR=/data/pip-cache \
    PYTHONPYCACHEPREFIX=/data/pycache \
    DEPLOYMENT_ENV=production \
    DJANGO_SETTINGS_MODULE=config.settings \
    PYTHONPATH=/app/djadmin \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DJANGO_STATIC_ROOT=/app/staticfiles \
    DJANGO_WHITENOISE_MANIFEST=1

# Системные + Python-зависимости
COPY djadmin/requirements.txt /app/djadmin/requirements.txt
RUN apt-get update && apt-get install -y --no-install-recommends libpq5 supervisor && \
    pip install -r /app/djadmin/requirements.txt && \
    rm -rf /var/lib/apt/lists/*

# Код (корневой .dockerignore урезает контекст)
COPY . .
COPY supervisord.djadmin.conf /etc/supervisor/conf.d/supervisord.conf

# Белая статика собирается НА СБОРКЕ (не при старте) — старт контейнера ~секунды
# вместо ~5 минут (collectstatic на /data был главной причиной окна 503 при деплое).
RUN SECRET_KEY=build-only-not-a-secret python /app/djadmin/manage.py collectstatic --noinput && \
    python -m compileall -q /app/djadmin && \
    useradd -m -u 1000 appuser && \
    mkdir -p /data/pip-cache /data/pycache && \
    chown -R appuser:appuser /app /data
USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

# Старт: опциональный gated SQL-migration runner (MIGRATIONS_ENABLED=true),
# затем Django migrate и supervisord. Без флага — обычный старт, как раньше.
CMD ["sh", "-c", "if [ \"$MIGRATIONS_ENABLED\" = \"true\" ]; then python /app/scripts/apply_migrations.py --dry-run && python /app/scripts/apply_migrations.py && python /app/scripts/check_migrations.py || exit 1; fi; python /app/djadmin/manage.py migrate --noinput && exec supervisord -c /etc/supervisor/conf.d/supervisord.conf"]
