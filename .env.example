# ============================================================
# Trudnik — Environment Variables (шаблон)
# ============================================================
# Скопируйте в .env и заполните реальными значениями.
# !!! НИКОГДА не коммитьте .env в репозиторий !!!
# ============================================================

# --- Flask ---
DEPLOYMENT_ENV=development
SECRET_KEY=change-me-to-generated-hex-64
ADMIN_API_TOKEN=change-me-to-generated-hex-64
MONETIZATION_ENABLED=false
WORKER_SITE_URL=
GIT_VERSION=dev
TEST_USER_PASSWORD=changeme123

# --- PostgreSQL / PostgREST ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=trudnik
PGUSER=postgres
PGPASSWORD=change-me-to-generated-hex-32
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/trudnik
POSTGREST_URL=http://localhost:3000
PGRST_JWT_SECRET=change-me-to-generated-hex-128

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# --- SMTP / Email ---
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=587
SMTP_USERNAME=trudnik-app@yandex.ru
SMTP_PASSWORD=change-me-to-app-password

# --- WebSocket ---
WEBSOCKET_JWT_SECRET=change-me-to-generated-hex-64
WEBSOCKET_PUBLIC_URL=wss://trudnik.ru/ws
WEBSOCKET_URL=ws://localhost:8001
WEBSOCKET_PORT=8001

# --- Push-уведомления (VAPID) ---
VAPID_PRIVATE_KEY=change-me-to-generated-vapid-private
VAPID_PUBLIC_KEY=change-me-to-generated-vapid-public
VAPID_CLAIMS_EMAIL=trudnik-app@yandex.ru

# --- Внешние API ---
YANDEX_GEOCODER_KEY=
# Yandex SmartCaptcha (резидентный РФ-сервис; замена Cloudflare Turnstile 2026-08, 152-ФЗ ст.12)
SMARTCAPTCHA_CLIENT_KEY=
SMARTCAPTCHA_SERVER_KEY=

# --- Платежи (YooKassa) ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# --- Загрузки ---
UPLOAD_FOLDER=uploads
MAX_PHOTO_SIZE_MB=5

# --- Мониторинг ---
ADMIN_API_ALLOWED_IPS=
