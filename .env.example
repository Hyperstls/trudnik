# Flask
DEPLOYMENT_ENV=development
SECRET_KEY=

# PostgreSQL / PostgREST
PGHOST=localhost
PGPORT=5432
PGDATABASE=trudnik
PGUSER=postgres
PGPASSWORD=
DATABASE_URL=postgresql://postgres:password@localhost:5432/trudnik
PGRST_URL=http://localhost:3000
PGRST_JWT_SECRET=  # Минимум 32 байта (256 бит) для HS256. Рекомендуется 64 байта (512 бит).

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# SMTP / Email
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Внешние API
YANDEX_GEOCODER_KEY=

# Загрузки
UPLOAD_FOLDER=uploads
MAX_PHOTO_SIZE_MB=5
