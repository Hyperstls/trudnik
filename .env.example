# Пример окружения. Скопируйте в .env и заполните значения.
# .env в .gitignore и НИКОГДА не коммитится. Секреты — только здесь/в панели Amvera.
# Прод с 2026-10-30 — Django (djadmin), Flask-архив в ветке main-flask.

# ── Django core ─────────────────────────────────────────────────────────────
DEPLOYMENT_ENV=development            # production на Amvera (влияет на DEBUG/HTTPS)
SECRET_KEY=                           # ОБЯЗАТЕЛЬНО в production; openssl rand -hex 32
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1   # прод: трудник.рф,xn--d1aigknli.xn--p1ai,.amvera.tech
DJANGO_CSRF_TRUSTED_ORIGINS=https://xn--d1aigknli.xn--p1ai,https://*.amvera.tech
DJANGO_LOG_LEVEL=INFO
DJANGO_STATIC_ROOT=                   # прод задаёт Dockerfile (/app/staticfiles); локально пусто
DJANGO_WHITENOISE_MANIFEST=1          # прод: 1

# ── База данных ─────────────────────────────────────────────────────────────
# Приоритет: DJANGO_DATABASE_URL (роль trudnik_dj) → DATABASE_URL.
DJANGO_DATABASE_URL=postgresql://trudnik_dj:CHANGE_ME@localhost:5433/trudnik  # pragma: allowlist secret
DATABASE_URL=postgresql://trudnik:CHANGE_ME@localhost:5433/trudnik  # pragma: allowlist secret
# Для scripts/apply_migrations.py и reconcile нужен админ-URL (SUPERUSER):
# DATABASE_ADMIN_URL=postgresql://postgres:CHANGE_ME@localhost:5433/trudnik  # pragma: allowlist secret
DJANGO_DB_NAME=trudnik

# ── Redis / Celery / WS ─────────────────────────────────────────────────────
REDIS_URL=redis://:CHANGE_ME@localhost:6379/0
CELERY_BROKER_URL=                    # по умолчанию = REDIS_URL

# ── Админка и безопасность ──────────────────────────────────────────────────
DJANGO_ADMIN_ALLOWED_IPS=             # пусто = без allowlist (staff-2FA отдельно)
ADMIN_2FA_REQUIRED=false              # true — staff-вход только по email-коду
ADMIN_BOOTSTRAP_EMAIL=                # одноразовый bootstrap superuser (прод: удалить после)
AUTH_RATE_LIMIT_PER_MIN=600           # авторизованные
GLOBAL_RATE_LIMIT_PER_MIN=120         # анонимные, на IP
METRICS_TOKEN=                        # /metrics: X-Metrics-Token; пусто на проде → 404

# ── URL-ы ───────────────────────────────────────────────────────────────────
SITE_URL=https://xn--d1aigknli.xn--p1ai
CANONICAL_HOST=xn--d1aigknli.xn--p1ai
WORKER_SITE_URL=https://xn--d1aigknli.xn--p1ai
SUPPORT_EMAIL=
UPLOAD_FOLDER=/data/uploads           # прод: persistenceMount /data
MAX_PHOTO_SIZE_MB=5

# ── SMTP (Яндекс, РФ) ───────────────────────────────────────────────────────
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_USERNAME=                        # дубль-алиас SMTP_USER (оба читаются)
SMTP_PASSWORD=                        # app-password, только в Amvera env
SMTP_USE_SSL=true
SMTP_USE_TLS=false
SMTP_TIMEOUT=15
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Трудник
TRANSACTIONAL_EMAIL_ASYNC=1

# ── Капча (Yandex SmartCaptcha, РФ) ─────────────────────────────────────────
SMARTCAPTCHA_CLIENT_KEY=
SMARTCAPTCHA_SERVER_KEY=
DJANGO_CAPTCHA_DISABLED=              # 1 — только локально/E2E

# ── Яндекс.Карты / геокодер ─────────────────────────────────────────────────
YANDEX_MAPS_API_KEY=
YANDEX_GEOCODER_KEY=
YANDEX_GEOCODER_REFERER=
YANDEX_SUGGEST_API_KEY=

# ── MAX-бот (РФ) ────────────────────────────────────────────────────────────
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
MAX_WEBHOOK_SECRET=                   # X-Max-Bot-Api-Secret, fail-closed
MAX_API_URL=https://botapi.max.ru
MESSENGER_API_TIMEOUT=15

# ── Web Push (VAPID) ────────────────────────────────────────────────────────
# ВНИМАНИЕ (152-ФЗ): при включении канала доставка идёт через Google/Mozilla —
# трансграничная передача. Сейчас канал ОТКЛЮЧЁН (WEB_PUSH_ENABLED=0);
# решение о декларировании — docs/rkn_notification_fill.md.
VAPID_PUBLIC_KEY=                     # 65-байтовый uncompressed P-256 (base64url, 87)
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=notifications@xn--d1aigknli.xn--p1ai
# 152-ФЗ: Web Push = трансграничная передача (Google/Mozilla). По решению
# владельца 2026-11-09 канал выключен; включать только после декларирования ст.12.
WEB_PUSH_ENABLED=0

# ── Legacy Flask (НЕ используется Django-продом) ────────────────────────────
# Оставлено для истории/совместимости ветки main-flask; в проде не задавать.
# PGHOST= PGPORT= PGDATABASE= PGUSER= PGPASSWORD=
# POSTGREST_URL= PGRST_URL= PGRST_JWT_SECRET=
# WEBSOCKET_PORT= WEBSOCKET_URL=
# YOOKASSA_ID= YOOKASSA_SECRET=
# MONETIZATION_ENABLED= TEST_USER_PASSWORD=
