# ============================================================
# Amvera env-файл для сервиса: trudnik (Flask приложение)
# Внутренний хост: amvera-hyperstls-run-trudnik
# ============================================================

# Flask
SECRET_KEY=PLACEHOLDER_SECRET_KEY
DEPLOYMENT_ENV=production
WORKER_SITE_URL=https://trudnik-hyperstls.amvera.io/

# Amvera PostgREST
POSTGREST_URL=http://amvera-hyperstls-run-trudnik-pr:3000
PGRST_JWT_SECRET=PLACEHOLDER_JWT_SECRET

# Amvera Redis
REDIS_URL=redis://:PLACEHOLDER_REDIS_PASSWORD@amvera-hyperstls-run-trudnik-redis:6379/0

# База данных (прямое подключение для миграций/pgAdmin)
DATABASE_URL=postgresql://trudnikapp:PLACEHOLDER_DB_PASSWORD@amvera-hyperstls-cnpg-trudnik-db-rw:5432/trudnik

# Email (SMTP Яндекс.Почта)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=587
SMTP_USER=trudnik-app@yandex.ru
SMTP_PASSWORD=PLACEHOLDER_SMTP_PASSWORD
SMTP_FROM_EMAIL=trudnik-app@yandex.ru
SMTP_FROM_NAME=Trudnik
SMTP_USE_TLS=True

# Yandex Maps
YANDEX_MAPS_API_KEY=PLACEHOLDER_YANDEX_GEOCODER_KEY

# Web Push (VAPID)
VAPID_PRIVATE_KEY=PLACEHOLDER_VAPID_PRIVATE_KEY
VAPID_PUBLIC_KEY=PLACEHOLDER_VAPID_PUBLIC_KEY
VAPID_CLAIMS_EMAIL=trudnik-app@yandex.ru

# WebSocket
WEBSOCKET_PORT=8001
